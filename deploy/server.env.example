# The prod server's settings (plan 010): the only file to edit for the server setup.
# Copy to deploy/server.env (git-ignored, never commit it), fill in every <...>, then run
#   sudo deploy/setup.sh
# Run it again after any change here.

# --- The prod instance ----------------------------------------------------------------
# Folder for everything of the instance (created), e.g. /srv/<name>.
PROD_DIR="<prod-dir>"
# systemd service name, and the system user it runs as (created).
SERVICE="<service-name>"
SERVICE_USER="<service-user>"
# Free local port the API listens on (127.0.0.1 only; nginx forwards to it).
PORT="<port>"

# --- Who may release (they also need push access to the GitHub repo) -------------------
RELEASE_GROUP="<release-group>"
# Login names on this server, separated by spaces; added to the group.
RELEASERS="<login> <login>"

# --- nginx -----------------------------------------------------------------------------
# The existing site file (with TLS) of the API's host name; the API is added to it under /v2/.
NGINX_SITE="/etc/nginx/sites-available/<site>"

# --- The API's settings (backend/.env.example says what each one does) -----------------
# The site's origin, without a path: https://<github-owner>.github.io, or the custom domain
# if the owner's Pages use one (.github.io then redirects there, and browsers send that).
CORS_ORIGIN="https://<site-domain>"
# Secret. Restrict it in Google Cloud to the YouTube Data API and this server's IP.
YOUTUBE_API_KEY="<key>"
# Optional cookies file for yt-dlp, readable by the service user; empty = none.
YTDLP_COOKIES=""
ANALYSIS_LIMIT_PER_IP="20"
ANALYSIS_LIMIT_PER_DAY="1000"

# --- The growing dataset (plan 013) -----------------------------------------------------
# The collector's folder on the big clips volume: clips, feature caches, a work folder and
# the daily backups of its database (created; owned by the service user). Not under /home.
COLLECTOR_CLIPS_DIR="<clips-dir>"
# Videos the collector adds a day.
COLLECT_PER_DAY="120"
# System user of the data bot, which commits the collected dataset to GitHub daily (created).
DATA_USER="<data-user>"

# --- Alert issues (plan 013, decision 12) -----------------------------------------------
# Secret. A fine-grained personal access token for this repo only, with one permission:
# "Issues: Read and write" (deploy/README.md, Alert issues). The hourly check opens an issue
# when the collector or one of its jobs hasn't worked for a day. Empty = it only logs.
ALERT_GITHUB_TOKEN=""
